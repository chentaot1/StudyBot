# Replace placeholders locally. Never commit your .env file.
DISCORD_TOKEN=replace_with_your_bot_token
OWNER_ID=replace_with_your_discord_user_id
# Required: one server ID, or a comma-separated list. Empty prevents startup.
ALLOWED_GUILD_IDS=replace_with_your_server_id
TIMEZONE=America/New_York
DB_PATH=study_bot.db
LOG_DIR=.
LOG_LEVEL=INFO

# Enable for the first boot to register slash commands in the configured server.
# Turn this off again after commands have registered; enable when updating commands.
SYNC_GUILD_COMMANDS=true
SYNC_COMMANDS=false
# Optional explicit guild for development command sync.
DEV_GUILD_ID=
# Global registration is needed for supported DM commands. See README.
SYNC_GLOBAL_COMMAND_SYNC=false

# Optional features: empty lists disable these personal allowlists.
LITE_USER_IDS=
DUO_LEADERBOARD_USER_IDS=
SB_PING_ROLE_ID=

# Fork operators: point this to the source of the version you actually run.
BOT_SOURCE_URL=https://github.com/chentaot1/StudyBot
